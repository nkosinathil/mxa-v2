# MxA Mobile - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials

# =============================================================================
# PRODUCT IDENTITY
# =============================================================================
PRODUCT_NAME="MxA Mobile"
PRODUCT_CODE="mxa-mobile"
PRODUCT_HOSTNAME="mobile.gismartanalytics.com"

# =============================================================================
# SERVER INFRASTRUCTURE
# =============================================================================

# SSO Server (Keycloak)
KEYCLOAK_SERVER_URL="http://192.168.1.59:8080"
KEYCLOAK_REALM="forensics"
KEYCLOAK_CLIENT_ID="mxa-mobile-web"
KEYCLOAK_CLIENT_SECRET="your-keycloak-client-secret-here"
KEYCLOAK_REDIRECT_URI="http://192.168.1.66/auth/callback"
KEYCLOAK_POST_LOGOUT_REDIRECT_URI="http://192.168.1.66/"

# Application Server (PHP + PostgreSQL)
APP_SERVER_IP="192.168.1.66"
APP_SERVER_URL="http://192.168.1.66"
APP_ENV="production"
APP_DEBUG="false"

# Python Server (FastAPI + Celery + MinIO)
PYTHON_SERVER_IP="192.168.1.90"
PYTHON_API_URL="http://192.168.1.90:8104"
PYTHON_API_PORT="8104"

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_CONNECTION="pgsql"
DB_HOST="192.168.1.66"
DB_PORT="5432"
DB_DATABASE="mxa_mobile"
DB_USERNAME="mxa_mobile_user"
DB_PASSWORD="your-database-password-here"
DB_SCHEMA="public"

# Database pool settings
DB_POOL_MIN="2"
DB_POOL_MAX="10"

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST="192.168.1.90"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD=""
REDIS_PREFIX="mxa_mobile:"

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================
CELERY_BROKER_URL="redis://192.168.1.90:6379/0"
CELERY_RESULT_BACKEND="redis://192.168.1.90:6379/0"
CELERY_QUEUE_NAME="mxa_mobile"
CELERY_WORKER_CONCURRENCY="4"
CELERY_TASK_TIME_LIMIT="3600"
CELERY_TASK_SOFT_TIME_LIMIT="3300"

# =============================================================================
# MINIO CONFIGURATION (Object Storage)
# =============================================================================
MINIO_ENDPOINT="192.168.1.90:9000"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_USE_SSL="false"
MINIO_REGION="us-east-1"

# MinIO Buckets (Product-specific)
MINIO_BUCKET_INPUT="mxa-mobile-input"
MINIO_BUCKET_OUTPUT="mxa-mobile-output"
MINIO_BUCKET_TEMP="mxa-mobile-temp"
MINIO_BUCKET_PREVIEWS="mxa-mobile-previews"

# =============================================================================
# PHP APPLICATION SETTINGS
# =============================================================================
PHP_APP_DIR="/var/www/mxa-mobile-app/current"
PHP_SESSION_LIFETIME="7200"
PHP_SESSION_SECURE="false"
PHP_SESSION_HTTP_ONLY="true"
PHP_SESSION_SAME_SITE="Lax"

# CSRF Protection
CSRF_TOKEN_NAME="csrf_token"
CSRF_TOKEN_LIFETIME="3600"

# Upload limits
UPLOAD_MAX_FILESIZE="2G"
UPLOAD_MAX_FILES="1000"
POST_MAX_SIZE="2G"
MEMORY_LIMIT="512M"

# =============================================================================
# PYTHON APPLICATION SETTINGS
# =============================================================================
PYTHON_APP_DIR="/opt/apps/mxa-mobile"
PYTHON_LOG_LEVEL="INFO"
PYTHON_WORKERS="4"

# Processing settings
ENABLE_AUDIO_TRANSCRIPTION="true"
AUDIO_MAX_TRANSCRIPTION_SECONDS="600"
ENABLE_OCR="true"
OCR_MIN_IMAGE_WIDTH="720"
OCR_MIN_IMAGE_HEIGHT="1280"

# Category models (comma-separated)
DEFAULT_CATEGORY_MODELS="generic"
AVAILABLE_CATEGORY_MODELS="generic,energy,banking,scm"

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL="info"
LOG_CHANNEL="daily"
LOG_PATH_PHP="/var/www/mxa-mobile-app/current/storage/logs"
LOG_PATH_PYTHON="/opt/apps/mxa-mobile/logs"

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Application keys (generate with: openssl rand -base64 32)
APP_KEY="your-app-encryption-key-here-32-chars"
JWT_SECRET="your-jwt-secret-key-here"

# Session security
SESSION_DRIVER="file"
SESSION_LIFETIME="120"
SESSION_ENCRYPT="true"

# CORS settings
CORS_ALLOWED_ORIGINS="http://192.168.1.66"
CORS_ALLOWED_METHODS="GET,POST,PUT,DELETE,OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type,Authorization,X-Requested-With"

# Rate limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_SECONDS="60"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_AUDIO_TRANSCRIPTION="true"
FEATURE_OCR_PROCESSING="true"
FEATURE_GPS_EXTRACTION="true"
FEATURE_NETWORK_VISUALIZATION="true"
FEATURE_EXPORT_REPORTS="true"

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Email notifications (optional)
MAIL_DRIVER="smtp"
MAIL_HOST=""
MAIL_PORT=""
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=""
MAIL_FROM_ADDRESS="noreply@gismartanalytics.com"
MAIL_FROM_NAME="MxA Mobile"

# Monitoring (optional)
SENTRY_DSN=""
MONITORING_ENABLED="false"

# =============================================================================
# DEPLOYMENT PATHS (Production)
# =============================================================================

# Apache/Web server
WEB_ROOT="/var/www/mxa-mobile-app/current/public"
APACHE_USER="www-data"
APACHE_GROUP="www-data"

# Python application
PYTHON_VENV="/opt/apps/mxa-mobile/venv"
CELERY_USER="celery"
CELERY_GROUP="celery"

# Systemd services
SYSTEMD_FASTAPI_SERVICE="mxa-mobile-api"
SYSTEMD_CELERY_SERVICE="mxa-mobile-worker"

# =============================================================================
# DEVELOPMENT SETTINGS (Override in .env.local)
# =============================================================================

# Development mode
# DEV_MODE="true"
# DEV_PHP_SERVER="localhost:8000"
# DEV_PYTHON_SERVER="localhost:8104"
# DEV_HOT_RELOAD="true"

# =============================================================================
# BACKUP AND MAINTENANCE
# =============================================================================
BACKUP_ENABLED="true"
BACKUP_RETENTION_DAYS="30"
BACKUP_PATH="/var/backups/mxa-mobile"

# Maintenance mode
MAINTENANCE_MODE="false"
MAINTENANCE_MESSAGE="System is currently under maintenance. Please check back later."

# =============================================================================
# NOTES
# =============================================================================
# 1. All passwords and secrets must be strong and unique
# 2. Never commit the .env file to version control
# 3. Use different values for development/staging/production
# 4. Rotate secrets regularly
# 5. Keep this template updated when adding new config options
