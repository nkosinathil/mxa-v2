APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me

# Redis/Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# MinIO (typically on python server network)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_INPUT=premium-ocr-input
MINIO_BUCKET_OUTPUT=premium-ocr-output
MINIO_PRESIGN_EXPIRE=3600

# PostgreSQL (application DB server)
POSTGRES_DSN=postgresql://premium_ocr:premium_ocr@192.168.1.66:5432/premium_ocr

# Runtime paths
UPLOAD_DIR=/workspace/python-backend/uploads
WORK_TMP_DIR=/workspace/python-backend/tmp
WORK_OUTPUT_DIR=/workspace/python-backend/output

# Toolkit path mounted on python server
TOOLKIT_PATH=/workspace
