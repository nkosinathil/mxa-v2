# MxA Mobile Python Backend - Environment Configuration
# Copy to .env and configure for your environment

# Application
APP_NAME="MxA Mobile Backend"
APP_ENV=production
DEBUG=false

# API Server
API_HOST=0.0.0.0
API_PORT=8104
API_WORKERS=4

# Database (PostgreSQL)
DB_HOST=192.168.1.66
DB_PORT=5432
DB_NAME=mxa_mobile
DB_USER=mxa_mobile_user
DB_PASSWORD=your-password-here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_HOST=192.168.1.90
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery
CELERY_BROKER_URL=redis://192.168.1.90:6379/0
CELERY_RESULT_BACKEND=redis://192.168.1.90:6379/0
CELERY_QUEUE_NAME=mxa_mobile
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

# MinIO (Object Storage)
MINIO_ENDPOINT=192.168.1.90:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET_INPUT=mxa-mobile-input
MINIO_BUCKET_OUTPUT=mxa-mobile-output
MINIO_BUCKET_TEMP=mxa-mobile-temp

# Keycloak (for token validation)
KEYCLOAK_SERVER_URL=http://192.168.1.59:8080
KEYCLOAK_REALM=forensics
KEYCLOAK_CLIENT_ID=mxa-mobile-web
KEYCLOAK_CLIENT_SECRET=your-secret-here

# Processing Settings
ENABLE_AUDIO_TRANSCRIPTION=true
AUDIO_MAX_TRANSCRIPTION_SECONDS=600
ENABLE_OCR=true
OCR_MIN_IMAGE_WIDTH=720
OCR_MIN_IMAGE_HEIGHT=1280
DEFAULT_CATEGORY_MODELS=generic

# Logging
LOG_LEVEL=INFO
LOG_FILE=/opt/apps/mxa-mobile/logs/api.log

# Paths (Production)
APP_DIR=/opt/apps/mxa-mobile
TEMP_DIR=/tmp/mxa-mobile
