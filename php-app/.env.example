APP_ENV=production
APP_URL=http://192.168.1.66
APP_NAME=Premium OCR

# Python API on processing server (via nginx reverse proxy)
PYTHON_API_BASE_URL=http://192.168.1.90
PYTHON_API_KEY=change-me

# SSO on dedicated identity server
# Prefer hostname to match Keycloak strict-host mode.
SSO_ISSUER=http://sso.gint.co.za/realms/premium-ocr
SSO_AUTHORIZE_URL=http://sso.gint.co.za/realms/premium-ocr/protocol/openid-connect/auth
SSO_TOKEN_URL=http://sso.gint.co.za/realms/premium-ocr/protocol/openid-connect/token
SSO_USERINFO_URL=http://sso.gint.co.za/realms/premium-ocr/protocol/openid-connect/userinfo
SSO_LOGOUT_URL=http://sso.gint.co.za/realms/premium-ocr/protocol/openid-connect/logout
SSO_CLIENT_ID=premium-ocr-web
SSO_CLIENT_SECRET=change-me
SSO_REDIRECT_URI=http://192.168.1.66/callback.php
SSO_SCOPES=openid profile email

# PHP filesystem paths
UPLOAD_TMP_DIR=/var/www/gismartanalytics/storage/uploads
LOG_DIR=/var/www/gismartanalytics/storage/logs
