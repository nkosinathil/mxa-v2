# MxA Mobile PHP Application Environment Configuration
# Copy to .env and configure for your environment

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.1.66

# Keycloak OIDC
KEYCLOAK_SERVER_URL=http://192.168.1.59:8080
KEYCLOAK_REALM=forensics
KEYCLOAK_CLIENT_ID=mxa-mobile-web
KEYCLOAK_CLIENT_SECRET=your-secret-here
KEYCLOAK_REDIRECT_URI=http://192.168.1.66/auth/callback

# Database
DB_HOST=192.168.1.66
DB_PORT=5432
DB_NAME=mxa_mobile
DB_USER=mxa_mobile_user
DB_PASSWORD=your-password-here

# Python API
PYTHON_API_URL=http://192.168.1.90:8104

# MinIO
MINIO_ENDPOINT=192.168.1.90:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_USE_SSL=false
MINIO_BUCKET_INPUT=mxa-mobile-input
MINIO_BUCKET_OUTPUT=mxa-mobile-output

# Session
SESSION_LIFETIME=7200
SESSION_SECURE=false

# Security
APP_KEY=your-32-char-encryption-key-here

# Logging
LOG_LEVEL=info
LOG_PATH=../storage/logs
