APP_ENV=production
APP_URL=http://192.168.1.66
APP_NAME=Premium OCR

# Python API on processing server
PYTHON_API_BASE_URL=http://192.168.1.90:8000
PYTHON_API_KEY=change-me

# SSO on dedicated identity server
SSO_ISSUER=http://192.168.1.59/realms/premium-ocr
SSO_AUTHORIZE_URL=http://192.168.1.59/realms/premium-ocr/protocol/openid-connect/auth
SSO_TOKEN_URL=http://192.168.1.59/realms/premium-ocr/protocol/openid-connect/token
SSO_USERINFO_URL=http://192.168.1.59/realms/premium-ocr/protocol/openid-connect/userinfo
SSO_LOGOUT_URL=http://192.168.1.59/realms/premium-ocr/protocol/openid-connect/logout
SSO_CLIENT_ID=premium-ocr-web
SSO_CLIENT_SECRET=change-me
SSO_REDIRECT_URI=http://192.168.1.66/callback.php
SSO_SCOPES=openid profile email

# PHP filesystem paths
UPLOAD_TMP_DIR=/workspace/php-app/storage/uploads
LOG_DIR=/workspace/php-app/storage/logs
