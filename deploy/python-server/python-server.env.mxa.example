# /opt/mxa/api/.env template aligned to discovered python server layout
APP_ENV=production
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=change-me

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_INPUT=premium-ocr-input
MINIO_BUCKET_OUTPUT=premium-ocr-output
MINIO_PRESIGN_EXPIRE=3600

POSTGRES_DSN=postgresql://premium_ocr:premium_ocr@192.168.1.66:5432/premium_ocr

UPLOAD_DIR=/opt/mxa/data/uploads
WORK_TMP_DIR=/opt/mxa/data/tmp
WORK_OUTPUT_DIR=/opt/mxa/data/output

TOOLKIT_PATH=/opt/mxa
