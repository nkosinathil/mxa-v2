[Unit]
Description=MxA Mobile Analytics Celery Worker
After=network.target redis-server.service mxa-api.service
Wants=redis-server.service

[Service]
Type=simple
User=pyminio
Group=pyminio
WorkingDirectory=/opt/mxa-mobile-analytics/api
EnvironmentFile=/opt/mxa-mobile-analytics/api/.env
ExecStart=/opt/mxa-mobile-analytics/api/venv/bin/celery -A app.tasks worker --loglevel=info --concurrency=4
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
